{
  "name": "chatstack",
  "version": "0.1.0",
  "description": "Tus datos de Substack en una base local que puedes preguntar en lenguaje natural",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc && npm run build:browser && npm run build:skill",
    "dev": "tsx src/cli.ts",
    "mcp": "node --no-warnings=ExperimentalWarning dist/cli.js mcp",
    "build:browser": "node scripts/build-browser.mjs",
    "build:skill": "node scripts/build-skill.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bin": {
    "chatstack": "./skills/chatstack/bin/chatstack.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "adm-zip": "^0.6.0",
    "csv-parse": "^7.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.5.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
